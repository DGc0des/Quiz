# Copy to .env and fill in from Supabase Dashboard → Project Settings → API Keys.
# Both values are public by design: they ship inside the app. Row-level security and
# the RPC checks protect the data, never these values. NEVER put a secret or
# service_role key here — anything prefixed EXPO_PUBLIC_ is bundled into the app.
#
# For EAS builds these must also be registered as EAS environment variables
# (`eas env:create`), because EAS Build does not upload this gitignored file.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Use the publishable key (sb_publishable_…), not the legacy JWT anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
