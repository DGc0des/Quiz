# Supabase config — copy to `.env` and fill in your values.
# Find these in: Supabase Dashboard → Project Settings → API
# The EXPO_PUBLIC_ prefix is required so Expo inlines them into the client bundle.
# Note: the anon key is public-by-design (it ships in the app); RLS is what protects data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
